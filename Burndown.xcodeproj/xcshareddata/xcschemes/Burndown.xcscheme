<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "2720"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES"
      buildArchitectures = "Automatic">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "#!/bin/sh&#10;set -e&#10;&#10;if [ -n &quot;$CI&quot; ]; then&#10;  exit 0&#10;fi&#10;&#10;unset SWIFT_DEBUG_INFORMATION_FORMAT&#10;unset SWIFT_DEBUG_INFORMATION_VERSION&#10;&#10;# Manual offset in case commit count decreases&#10;OFFSET=0&#10;&#10;# Figure out paths&#10;CONFIG_DIR=&quot;${PROJECT_DIR}/Config&quot;&#10;BUILD_CONFIG=&quot;${CONFIG_DIR}/BuildNumber.xcconfig&quot;&#10;&#10;cd &quot;$PROJECT_DIR&quot;&#10;mkdir -p &quot;$CONFIG_DIR&quot;&#10;&#10;# Generate build number from commit count + offset&#10;COMMIT_COUNT=$(git -C &quot;$PROJECT_DIR&quot; rev-list --count HEAD 2&gt;/dev/null || echo 1)&#10;BUILD_NUMBER=$((COMMIT_COUNT + OFFSET))&#10;&#10;# Determine dirty/clean status and working tree hash&#10;IS_DIRTY=false&#10;if ! git -C &quot;$PROJECT_DIR&quot; diff --quiet || ! git -C &quot;$PROJECT_DIR&quot; diff --cached --quiet; then&#10;  IS_DIRTY=true&#10;fi&#10;&#10;# Get working tree hash&#10;STATUS=$(git status --porcelain=v1 --untracked-files=all)&#10;DIFF=$(git diff HEAD)&#10;BUILD_WORKING_HASH=$(printf &quot;%s\n%s&quot; &quot;$STATUS&quot; &quot;$DIFF&quot; | shasum | cut -c1-3)&#10;&#10;# Write values back to BuildNumber.xcconfig&#10;cat &gt; &quot;$BUILD_CONFIG&quot; &lt;&lt;EOF&#10;// Auto-generated. Do not edit by hand.&#10;&#10;CURRENT_PROJECT_VERSION = $BUILD_NUMBER&#10;BUILD_IS_DIRTY = $IS_DIRTY&#10;BUILD_WORKING_HASH = $BUILD_WORKING_HASH&#10;EOF">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "000000000000000100000000"
                     BuildableName = "Burndown.app"
                     ReferencedContainer = "container:Burndown.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "000000000000000100000000"
               BuildableName = "Burndown.app"
               ReferencedContainer = "container:Burndown.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Preserve Build Symbols"
               scriptText = "#!/bin/sh&#10;# Scheme post-actions run after Xcode's GenerateDSYMFile tasks, outside target script sandboxing.&#10;unset SWIFT_DEBUG_INFORMATION_FORMAT SWIFT_DEBUG_INFORMATION_VERSION&#10;/bin/bash &lt;&lt;'SLATE_PRESERVE_SYMBOLS'&#10;set -euo pipefail&#10;&#10;# JSON projects can export SDKROOT=auto and an empty XCODE_DEVELOPER_DIR_PATH.&#10;# These are build settings, not usable SDK/tool lookup overrides for host utilities.&#10;unset SDKROOT XCODE_DEVELOPER_DIR_PATH&#10;&#10;fail() {&#10;    echo &quot;error: Slate symbol preservation: $*&quot; &gt;&amp;2&#10;    exit 1&#10;}&#10;&#10;case &quot;${ACTION:-build}&quot; in&#10;    clean) exit 0 ;;&#10;esac&#10;&#10;inbox=&quot;${POLYLOGS_SYMBOL_INBOX:-$HOME/Library/Developer/PolyLogs/SymbolInbox}&quot;&#10;inbox_budget_kib=$((1024 * 1024))&#10;reserve_kib=$((20 * 1024 * 1024))&#10;[ -n &quot;${BUILT_PRODUCTS_DIR:-}&quot; ] || fail &quot;BUILT_PRODUCTS_DIR is missing; provide build settings from a scheme build target.&quot;&#10;[ -d &quot;$BUILT_PRODUCTS_DIR&quot; ] || fail &quot;Build products directory does not exist: $BUILT_PRODUCTS_DIR&quot;&#10;skip_capture() {&#10;    echo &quot;Slate skipped symbol capture: $*.&quot;&#10;}&#10;mkdir -p &quot;$inbox&quot;&#10;# Serialize accounting and publication across all updated schemes using this inbox. The kernel&#10;# releases the lock after a crash. Keep the file so every producer locks the same inode.&#10;exec 9&gt;&gt;&quot;$inbox/.capture.lock&quot;&#10;if ! /usr/bin/lockf -s -t 0 9; then&#10;    skip_capture &quot;another collector is using the inbox or its lock is unavailable&quot;&#10;    exit 0&#10;fi&#10;# A process killed mid-copy can leave its stage behind. Only the new, globally&#10;# locked collector uses this prefix; never clean up a legacy producer's stage.&#10;for abandoned in &quot;$inbox&quot;/*/.budget-incoming.??????; do&#10;    [ -d &quot;$abandoned&quot; ] &amp;&amp; [ ! -L &quot;$abandoned&quot; ] || continue&#10;    parent=&quot;${abandoned%/*}&quot;&#10;    [ ! -L &quot;$parent&quot; ] || continue&#10;    [[ &quot;${parent##*/}&quot; =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] || continue&#10;    /bin/rm -rf &quot;$abandoned&quot;&#10;done&#10;&#10;free_kib() {&#10;    LC_ALL=C /bin/df -Pk &quot;$1&quot; | /usr/bin/awk 'END { if (NR &gt; 1 &amp;&amp; $4 ~ /^[0-9]+$/) print $4; else exit 1 }'&#10;}&#10;&#10;has_capture_space() {&#10;    local requested=&quot;$1&quot; usage free&#10;    if ! usage=&quot;$(/usr/bin/du -Ask &quot;$inbox&quot;)&quot; || ! free=&quot;$(free_kib &quot;$inbox&quot;)&quot;; then&#10;        skip_capture &quot;could not measure inbox storage&quot;&#10;        return 1&#10;    fi&#10;    usage=&quot;${usage%%$'\t'*}&quot;&#10;    if (( usage + requested &gt; inbox_budget_kib )); then&#10;        skip_capture &quot;the 1 GiB symbol inbox budget would be exceeded&quot;&#10;        return 1&#10;    fi&#10;    if (( free &lt; reserve_kib + requested )); then&#10;        skip_capture &quot;the inbox volume would fall below the 20 GiB free-space reserve&quot;&#10;        return 1&#10;    fi&#10;}&#10;&#10;has_capture_space 256 || exit 0&#10;dwarfdump=&quot;$(/usr/bin/xcrun --find dwarfdump)&quot;&#10;dsymutil=&quot;$(/usr/bin/xcrun --find dsymutil)&quot;&#10;work=&quot;$(mktemp -d &quot;${TMPDIR:-/private/tmp}/slate-symbols.XXXXXX&quot;)&quot;&#10;stage=&quot;&quot;&#10;lock=&quot;&quot;&#10;cleanup() {&#10;    [ -z &quot;$stage&quot; ] || /bin/rm -rf &quot;$stage&quot;&#10;    [ -z &quot;$lock&quot; ] || /bin/rmdir &quot;$lock&quot;&#10;    /bin/rm -rf &quot;$work&quot;&#10;}&#10;trap cleanup EXIT&#10;trap 'echo &quot;error: Slate could not preserve build symbols (line $LINENO).&quot; &gt;&amp;2' ERR&#10;&#10;# Keep whole dSYM bundles, including all DWARF members and universal slices. Consumers&#10;# use UUID + architecture, never a product name or build number, as the matching key.&#10;preserve() {&#10;    local bundle=&quot;$1&quot; uuids label uuid architecture rest destination size&#10;    uuids=&quot;$(&quot;$dwarfdump&quot; --uuid &quot;$bundle&quot;)&quot;&#10;    [ -n &quot;$uuids&quot; ] || fail &quot;No UUIDs found in $bundle&quot;&#10;    if ! size=&quot;$(/usr/bin/du -Ask &quot;$bundle&quot;)&quot;; then&#10;        skip_capture &quot;could not measure the dSYM&quot;&#10;        return 0&#10;    fi&#10;    size=&quot;${size%%$'\t'*}&quot;&#10;    while read -r label uuid architecture rest; do&#10;        [ &quot;$label&quot; = &quot;UUID:&quot; ] || continue&#10;        [[ &quot;$uuid&quot; =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] \&#10;            || fail &quot;Invalid symbol UUID: $uuid&quot;&#10;        uuid=&quot;$(printf '%s' &quot;$uuid&quot; | /usr/bin/tr '[:lower:]' '[:upper:]')&quot;&#10;        architecture=&quot;${architecture#(}&quot;&#10;        architecture=&quot;${architecture%)}&quot;&#10;        [[ &quot;$architecture&quot; =~ ^[a-zA-Z0-9_]+$ ]] || fail &quot;Invalid architecture: $architecture&quot;&#10;        destination=&quot;$inbox/$uuid/$architecture&quot;&#10;        if [ -d &quot;$destination/Symbols.dSYM&quot; ]; then&#10;            continue&#10;        fi&#10;        has_capture_space &quot;$((size + 256))&quot; || continue&#10;        mkdir -p &quot;$inbox/$uuid&quot;&#10;        if ! mkdir &quot;$inbox/$uuid/.$architecture.lock&quot; 2&gt;/dev/null; then&#10;            # Another build may be publishing the same UUID. Never expose a partial bundle.&#10;            [ -d &quot;$destination/Symbols.dSYM&quot; ] &amp;&amp; continue&#10;            fail &quot;Concurrent publication or stale lock: $inbox/$uuid/.$architecture.lock. Retry after the other build finishes; remove the lock only if no collector is running.&quot;&#10;        fi&#10;        lock=&quot;$inbox/$uuid/.$architecture.lock&quot;&#10;        if [ ! -d &quot;$destination/Symbols.dSYM&quot; ]; then&#10;            [ ! -e &quot;$destination&quot; ] || fail &quot;Incomplete inbox entry: $destination&quot;&#10;            stage=&quot;$(mktemp -d &quot;$inbox/$uuid/.budget-incoming.XXXXXX&quot;)&quot;&#10;            /usr/bin/ditto &quot;$bundle&quot; &quot;$stage/Symbols.dSYM&quot;&#10;            /usr/bin/plutil -create xml1 &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert project -string &quot;${PROJECT_FILE_PATH:-}&quot; &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert target -string &quot;${TARGET_NAME:-}&quot; &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert configuration -string &quot;${CONFIGURATION:-}&quot; &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert sdk -string &quot;${PLATFORM_NAME:-}&quot; &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert source -string &quot;$bundle&quot; &quot;$stage/Build.plist&quot;&#10;            /usr/bin/plutil -insert capturedAt -string &quot;$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)&quot; &quot;$stage/Build.plist&quot;&#10;            if ! has_capture_space 0; then&#10;                /bin/rm -rf &quot;$stage&quot;&#10;                stage=&quot;&quot;&#10;                /bin/rmdir &quot;$lock&quot;&#10;                lock=&quot;&quot;&#10;                continue&#10;            fi&#10;            /bin/mv &quot;$stage&quot; &quot;$destination&quot;&#10;            stage=&quot;&quot;&#10;            echo &quot;Slate preserved symbols: $uuid ($architecture)&quot;&#10;        fi&#10;        /bin/rmdir &quot;$lock&quot;&#10;        lock=&quot;&quot;&#10;    done &lt;&lt;&lt; &quot;$uuids&quot;&#10;}&#10;&#10;roots=(&quot;$BUILT_PRODUCTS_DIR&quot;)&#10;if [ -n &quot;${DWARF_DSYM_FOLDER_PATH:-}&quot; ] &amp;&amp; [ &quot;$DWARF_DSYM_FOLDER_PATH&quot; != &quot;$BUILT_PRODUCTS_DIR&quot; ] &amp;&amp; [ -d &quot;$DWARF_DSYM_FOLDER_PATH&quot; ]; then&#10;    roots+=(&quot;$DWARF_DSYM_FOLDER_PATH&quot;)&#10;fi&#10;&#10;# Scan all products, not just the launcher's dSYM: embedded extensions and frameworks&#10;# may each carry their own UUIDs. A repeated bundle is harmless and deduplicated above.&#10;/usr/bin/find &quot;${roots[@]}&quot; -type d -name '*.dSYM' -prune -print0 &gt; &quot;$work/bundles&quot;&#10;while IFS= read -r -d '' bundle; do&#10;    preserve &quot;$bundle&quot;&#10;done &lt; &quot;$work/bundles&quot;&#10;&#10;# With ENABLE_DEBUG_DYLIB, app code can live in a separate Mach-O rather than the&#10;# launcher. If Xcode did not emit its UUID in a dSYM, resolve its debug map now,&#10;# while the original object files still exist.&#10;/usr/bin/find &quot;${roots[@]}&quot; -type d -name '*.dSYM' -prune -o -type f -name '*.debug.dylib' -print0 &gt; &quot;$work/dylibs&quot;&#10;while IFS= read -r -d '' binary; do&#10;    uuids=&quot;$(&quot;$dwarfdump&quot; --uuid &quot;$binary&quot;)&quot;&#10;    [ -n &quot;$uuids&quot; ] || fail &quot;No UUIDs found in $binary&quot;&#10;    missing=false&#10;    while read -r label uuid architecture rest; do&#10;        [ &quot;$label&quot; = &quot;UUID:&quot; ] || continue&#10;        architecture=&quot;${architecture#(}&quot;&#10;        architecture=&quot;${architecture%)}&quot;&#10;        [ -d &quot;$inbox/$uuid/$architecture/Symbols.dSYM&quot; ] || missing=true&#10;    done &lt;&lt;&lt; &quot;$uuids&quot;&#10;    if [ &quot;$missing&quot; = true ]; then&#10;        has_capture_space 256 || break&#10;        if ! work_free=&quot;$(free_kib &quot;$work&quot;)&quot; || (( work_free &lt; reserve_kib + inbox_budget_kib )); then&#10;            skip_capture &quot;the scratch volume lacks room to generate a dSYM above the 20 GiB reserve&quot;&#10;            break&#10;        fi&#10;        # A generated debug-dylib dSYM contains one DWARF file. Bound that file even before its&#10;        # size is known, so an oversized result cannot spend through the scratch reserve.&#10;        if (ulimit -f &quot;$inbox_budget_kib&quot; &amp;&amp; &quot;$dsymutil&quot; &quot;$binary&quot; -o &quot;$work/DebugDylib.dSYM&quot;); then&#10;            preserve &quot;$work/DebugDylib.dSYM&quot;&#10;        else&#10;            status=$?&#10;            if (( status == 128 + $(kill -l XFSZ) )) ||&#10;                { [ -d &quot;$work/DebugDylib.dSYM&quot; ] &amp;&amp; [ &quot;$(/usr/bin/du -Ask &quot;$work/DebugDylib.dSYM&quot; | /usr/bin/awk '{print $1}')&quot; -ge &quot;$inbox_budget_kib&quot; ]; }&#10;            then&#10;                skip_capture &quot;the generated dSYM exceeds the inbox budget&quot;&#10;            else&#10;                fail &quot;Could not generate symbols for $binary&quot;&#10;            fi&#10;        fi&#10;        /bin/rm -rf &quot;$work/DebugDylib.dSYM&quot;&#10;    fi&#10;done &lt; &quot;$work/dylibs&quot;&#10;SLATE_PRESERVE_SYMBOLS&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "000000000000000100000000"
                     BuildableName = "Burndown.app"
                     ReferencedContainer = "container:Burndown.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </BuildAction>
